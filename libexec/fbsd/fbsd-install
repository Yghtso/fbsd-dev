#!/bin/sh
# summary: install a built world+kernel into a new boot environment (beinstall.sh)
set -eu
. "${FBSD_ROOT:?run this through bin/fbsd}/lib/fbsd/common.sh"
. "$FBSD_ROOT/lib/fbsd/config.sh"
. "$FBSD_ROOT/lib/fbsd/qemu.sh"
. "$FBSD_ROOT/lib/fbsd/guest.sh"
. "$FBSD_ROOT/lib/fbsd/build.sh"

usage() {
	cat <<EOF
usage: fbsd install world [-nr] [-k kernconf]

Install the world and kernel built by 'fbsd build world' and
'fbsd build kernel' into a NEW ZFS boot environment, using the source tree's
own tools/build/beinstall.sh (run as root through FBSD_GUEST_SU). The running
boot environment is never modified.

beinstall.sh creates the BE <version>-<commit date>, runs installkernel,
etcupdate and installworld inside it and activates it. Two adjustments for
this pkgbase system:
  NO_PKG_UPGRADE=1  beinstall would otherwise run 'pkg upgrade' inside the
                    new BE, which replaces the world you just installed with
                    the FreeBSD-* base packages from the package repository
  bectl activate -t afterwards the previous BE is made the default again and
                    the new one is activated for the NEXT BOOT ONLY: if it
                    does not come up, the following boot is back on the old BE

Afterwards, inside the new BE: /etc/fbsd-world records the commit, and the
FreeBSD-base repository is disabled in /usr/local/etc/pkg/repos/FreeBSD.conf
(the old file is kept as FreeBSD.conf.fbsd-bak), so 'pkg upgrade' there
only touches ports packages. The pkg database still lists the FreeBSD-*
packages of the image; leave them alone. 'fbsd doctor' warns if the base
repository is enabled in a source-built BE.

To keep the new BE after testing it:  fbsd ssh sudo bectl activate <name>

Options:
  -n            dry run: print the ssh command and guest script
  -r            reboot into the new BE afterwards and report what booted
  -k kernconf   kernel config to install (default FBSD_KERNCONF)

Examples:
  fbsd build world && fbsd build kernel && fbsd install world -r
  fbsd -n install world
EOF
}

[ $# -gt 0 ] || usage_error "missing target: world"
case $1 in
-h | help) usage && exit 0 ;;
world) shift ;;
*) usage_error "unknown install target: $1 (only 'world'; kernels: fbsd ktest)" ;;
esac
reboot=0 kernconf=''
while getopts nhrk: opt; do
	case $opt in
	n) FBSD_DRYRUN=$((FBSD_DRYRUN + 1)) ;;
	h) usage && exit 0 ;;
	r) reboot=1 ;;
	k) kernconf=$OPTARG ;;
	*) usage_error "unknown option" ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || usage_error "unexpected argument: $1"

fbsd_load_config
: "${kernconf:=$FBSD_KERNCONF}"
case $kernconf in '' | *[!A-Za-z0-9_.-]*) usage_error "invalid kernel config name: $kernconf" ;; esac
if ! is_dryrun; then
	vm_running || die "VM $FBSD_VM_NAME is not running" "fbsd vm up -w"
	guest_reachable || die "cannot ssh to the guest" "fbsd doctor"
fi

log=$FBSD_LOGDIR/build/$(date +%Y%m%d-%H%M%S)-install-world.log

# The job runs as FBSD_SSH_USER and hands one root script to FBSD_GUEST_SU
# through a here-document, so the dry run reads like what you would type.
# shellcheck disable=SC2016 # expanded by the guest shell
script="$FBSD_GUEST_SU /bin/sh -s <<'FBSD_ROOT'
src=$(shquote "$FBSD_SRC") kernconf=$(shquote "$kernconf")"'
set -eu
cd "$src"
rev=$(git rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
before=$(mktemp)
bectl list -H | awk "{print \$1}" >"$before"
default=$(bectl list -H | awk "\$2 ~ /R/ {print \$1}")
echo ">>> fbsd: running tools/build/beinstall.sh KERNCONF=$kernconf (NO_PKG_UPGRADE=1)"
# </dev/null: the rest of this here-document must not be read as answers
# by anything interactive inside (etcupdate resolve).
env NO_PKG_UPGRADE=1 sh tools/build/beinstall.sh KERNCONF="$kernconf" </dev/null
new=$(bectl list -H | awk "{print \$1}" | grep -vxFf "$before" | head -n 1)
rm -f "$before"
[ -n "$new" ] || { echo "fbsd: cannot find the new boot environment"; exit 1; }
# Mark the BE as source-built and turn off the pkgbase base repository in
# it, so pkg upgrade there only touches ports packages.
mnt=$(mktemp -d)
bectl mount "$new" "$mnt" >/dev/null
printf "%s\n" "world installed from $src at $rev by fbsd install world, $(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$mnt/etc/fbsd-world"
repos=$mnt/usr/local/etc/pkg/repos
mkdir -p "$repos"
[ ! -f "$repos/FreeBSD.conf" ] || cp -p "$repos/FreeBSD.conf" "$repos/FreeBSD.conf.fbsd-bak"
printf "%s\n" "# fbsd install world: this BE has a source-built world" "FreeBSD-base: { enabled: no }" >"$repos/FreeBSD.conf"
bectl umount "$new"
rmdir "$mnt"
echo ">>> fbsd: marked $new as source-built (/etc/fbsd-world), FreeBSD-base repo disabled in it"
echo ">>> fbsd: keeping $default as the default, booting $new once (bectl activate -t)"
bectl activate "$default"
bectl activate -t "$new"
echo "fbsd-new-be=$new"
bectl list
FBSD_ROOT'

is_dryrun || info "installing into a new boot environment (log on the host)"
guest_logged "$log" '^>>> |^Boot environment |^fbsd-new-be=|^fbsd: ' "$script"
if is_dryrun; then
	[ "$reboot" = 0 ] || guest_reboot
	exit 0
fi
new=$(sed -n 's/^fbsd-new-be=//p' "$log" | tail -n 1)
info "new boot environment: $new (next boot only)"
if [ "$reboot" = 0 ]; then
	info "boot it with: fbsd vm reboot"
	exit 0
fi
guest_reboot
be=$(guest_ssh probe "bectl list -H | awk '\$2 ~ /N/ {print \$1}'" 2>/dev/null) || be='?'
ver=$(guest_ssh probe 'freebsd-version -ku | tr "\n" " "' 2>/dev/null) || ver='?'
if [ "$be" = "$new" ]; then
	info "booted the new boot environment $new (freebsd-version -ku: $ver)"
	info "keep it with: fbsd ssh sudo bectl activate $new"
else
	warn "booted $be, not the new boot environment $new; the next boot stays on $be"
	exit 1
fi
